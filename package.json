{
  "name": "novaforge-sim",
  "version": "0.1.0",
  "description": "A browser-native autonomy simulation lab for deterministic robot testing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "batch": "tsx src/cli/batch.ts"
  },
  "keywords": [
    "robotics",
    "simulation",
    "autonomy",
    "ros2",
    "lidar",
    "path-planning",
    "digital-twin"
  ],
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
