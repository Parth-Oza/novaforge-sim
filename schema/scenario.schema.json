{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Parth-Oza/novaforge-sim/schema/scenario.schema.json",
  "title": "NovaForge simulation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "seed",
    "width",
    "height",
    "gridSize",
    "durationSeconds",
    "lidar",
    "acceptance",
    "robots",
    "obstacles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "seed": { "type": "integer", "minimum": 1 },
    "width": { "type": "number", "exclusiveMinimum": 100 },
    "height": { "type": "number", "exclusiveMinimum": 100 },
    "gridSize": { "type": "number", "exclusiveMinimum": 2 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "lidar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rays", "maxRange", "noiseStdDev"],
      "properties": {
        "rays": { "type": "integer", "minimum": 4, "maximum": 2048 },
        "maxRange": { "type": "number", "exclusiveMinimum": 0 },
        "noiseStdDev": { "type": "number", "minimum": 0 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minCompletionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "minArrivalPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxSafetyHolds": { "type": "integer", "minimum": 0 },
        "maxReplans": { "type": "integer", "minimum": 0 }
      }
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/robot" }
    },
    "obstacles": {
      "type": "array",
      "items": { "$ref": "#/$defs/obstacle" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "goal", "radius", "maxSpeed", "color"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/point" },
        "goal": { "$ref": "#/$defs/point" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "maxSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "obstacle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "enum": ["rack", "wall", "rock", "dynamic"] },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["velocity"],
          "properties": {
            "velocity": { "$ref": "#/$defs/point" }
          }
        }
      }
    }
  }
}
